{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/resume", "/resume/"]
  },
  "vars": {
    "LASTFM_USERNAME": "aarav-g-168"
  }
}
